  "_weightRulesNote": "First match wins, so put specific terms above general ones. lb: 999 forces local-pickup-only pricing (no shipping cost, but the buyer pool is local).",
  "resaleHaircuts": [
    {
      "id": "branded-title",
      "match": [
        "salvage title",
        "rebuilt title",
        "branded title",
        "reconstructed title",
        "salvage vehicle"
      ],
      "pct": 0.3,
      "note": "A branded title cuts resale by roughly a third no matter how well the repair is done."
    },
    {
      "id": "no-title",
      "match": [
        "no title",
        "lost title",
        "bill of sale only",
        "title lost"
      ],
      "pct": 0.35,
      "note": "No title means a limited buyer pool and a paperwork fight."
    },
    {
      "id": "high-mileage",
      "match": [
        "high miles",
        "high mileage",
        "over 200k",
        "250k miles",
        "300k miles"
      ],
      "pct": 0.15,
      "note": "High-mileage examples sit below the comp median."
    },
    {
      "id": "missing-accessories",
      "match": [
        "no charger",
        "no power cord",
        "no remote",
        "no controller",
        "no stand",
        "no cables",
        "no power supply",
        "no keys"
      ],
      "pct": 0.08,
      "note": "Buyers discount an incomplete package, and you will likely supply the missing piece."
    },
    {
      "id": "cosmetic-damage",
      "match": [
        "scratched",
        "dented",
        "scuffed",
        "cosmetic damage",
        "yellowed",
        "rust",
        "water stains"
      ],
      "pct": 0.12,
      "note": "Cosmetic condition drives used-electronics pricing more than sellers expect."
    },
    {
      "id": "smoke-pet",
      "match": [
        "smoke smell",
        "smoker home",
        "pet hair",
        "musty"
      ],
      "pct": 0.15,
      "note": "Smoke and pet odour are the top cause of returns on shipped electronics."
    }
  ],
  "_resaleHaircutsNote": "Multiplicative reductions applied to the comp median when the listing text matches. They compound, and the total is capped at 60% so one badly-worded ad cannot zero out a valuation."
}