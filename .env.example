# eBay Developer Program application keyset (developer.ebay.com -> your app -> Production keys)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
EBAY_ENV=production

# Comp price source: "manual" (default, see Settings > Searches) or "marketplace_insights"
# (only if/when eBay approves Limited Release access - see app/comps.py)
COMP_PROVIDER=manual

# Where the SQLite DB file lives inside the container (matches the docker-compose volume)
DATABASE_PATH=/app/data/ebay_deals.db

# SMTP for the daily digest email. Example for Gmail: smtp.gmail.com / 587, and use an
# App Password (not your normal password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_ADDRESS=

# Timezone used to interpret the daily digest send time set in Settings > Notifications
APP_TIMEZONE=America/New_York
