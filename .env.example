# ---------------------------------------------------------------------------
# Scavenger configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

PORT=8080
# Absolute or relative path to the SQLite file. Leave unset to use
# server/data/scavenger.db regardless of which directory you start from.
# DATABASE_PATH=

# How often the poller sweeps every enabled search profile (seconds).
# Craigslist tolerates ~1 req / 2s. 90-180s is a good balance of freshness
# vs. being a good citizen. Notifications fire within one sweep of a listing.
POLL_INTERVAL_SECONDS=120

# --- Home / fallback location -----------------------------------------------
# Used when the phone has not reported a live GPS fix yet.
HOME_LAT=
HOME_LON=
HOME_ZIP=

# --- eBay (resale comps) ----------------------------------------------------
# Create an app at https://developer.ebay.com -> keyset (production).
# The Browse API (active listings) works with any keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# Marketplace Insights gives *sold* comps and is far more accurate, but eBay
# gates it behind an application. Set to true once you have been granted it.
EBAY_INSIGHTS_ENABLED=false

# --- Push notifications -----------------------------------------------------
# Web push (works on Android + iOS 16.4+ when installed to the home screen).
# Generate a pair with: npm run gen:vapid --workspace=server
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ntfy.sh is the zero-setup fallback: install the ntfy app, subscribe to a
# private random topic name, and put that topic here.
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# --- Sources ----------------------------------------------------------------
# Comma-separated. See docs/SOURCES.md before enabling anything but craigslist.
ENABLED_SOURCES=craigslist,sample

# Craigslist regional subdomain(s) to sweep, comma separated (e.g. sfbay,sacramento)
CRAIGSLIST_SITES=sfbay

# Facebook Marketplace has no public API. Point this at your own licensed
# provider (see docs/SOURCES.md); leave blank to keep the adapter dormant.
FB_PROVIDER_URL=
FB_PROVIDER_KEY=

OFFERUP_PROVIDER_URL=
OFFERUP_PROVIDER_KEY=
